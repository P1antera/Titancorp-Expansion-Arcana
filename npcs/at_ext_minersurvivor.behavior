      {
        "title": "accuse",
        "type": "module",
        "name": "accuse",
        "parameters": {}
      },
      {
        "title": "Construction Warning",
        "type": "decorator",
        "name": "cooldown",
        "parameters": {
          "cooldown": {"value": 30},
          "onFail": {"value": false},
          "onSuccess": {"value": true}
        },
        "child": {
          "title": "Warn Nearby Player",
          "type": "composite",
          "name": "sequence",
          "parameters": {},
          "children": [
            {
              "title": "Find Nearest Player",
              "type": "action",
              "name": "queryEntity",
              "parameters": {
                "entityTypes": {"value": ["player"]},
                "orderBy": {"value": "nearest"},
                "position": {"key": "self"},
                "range": {"value": 15},
                "withoutEntity": {"key": "self"}
              },
              "output": {
                "entity": "player"
              }
            },
            {
              "title": "Display Construction Warning",
              "type": "action",
              "name": "sayToEntity",
              "parameters": {
                "dialogType": {"value": "dialog.hail"},
                "entity": {"key": "player"},
                "tags": {"value": {}}
              }
            }
          ]
        }
      },
      {
        "title": "converse",
        "type": "module",
        "name": "converse",
        "parameters": {}
      },
      {
        "title": "Finish Interrupted Cargo Delivery",
