            "cycle" : 0.5,
            "mode" : "transition",
            "transition" : "landed"
          },
          "flying" : {
            "frames" : 2,
            "cycle" : 0.2,
            "mode" : "loop"
          },
          "up" : {
            "frames" : 3,
            "cycle" : 0.5,
            "mode" : "transition",
            "transition" : "flying"
          }
        }
      },
