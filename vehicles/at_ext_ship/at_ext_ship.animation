{
  "animatedParts" : {
    "stateTypes" : {
      "bottomthrust" : {
        "default" : "off",
        "states" : {
          "off" : {
          },
          "idle" : {
            "frames" : 2,
            "cycle" : 0.3,
            "mode" : "loop"
          },
          "on" : {
            "frames" : 4,
            "cycle" : 0.2,
            "mode" : "loop"
          }
