{
  "animatedParts" : {
    "stateTypes" : {
      "drinkState" : {
        "default" : "idle",
        "states" : {
          "idle" : {
            "frames" : 1
          },
          "raise" : {
            "frames" : 1
          },
          "drink" : {
            "frames" : 5,
            "cycle" : 3.0,
            "mode" : "end"
          },
          "recap" : {
            "frames" : 1
          }
        }
      }
    },

    "parts" : {
      "drink" : {
        "properties" : {
          "zLevel" : 0,
          "centered" : true,
          "image" : "<partImage>:idle",
          "offset" : [0, 0.25],
          "transformationGroups" : [ "drink" ]
        },
        "partStates" : {
          "drinkState" : {
            "idle" : {
              "properties" : {
                "offset" : [-0.3, 0.5],
                "image" : "<partImage>:idle"
              }
            },
            "raise" : {
              "properties" : {
                "offset" : [-0.4, -0.4],
                "image" : "<partImage>:raise"
              }
            },
            "drink" : {
              "properties" : {
                "offset" : [0.1, 0],
                "zLevel" : 10,
                "image" : "<partImage>:drink.<frame>"
              }
            },
            "recap" : {
              "properties" : {
                "offset" : [-0.4, -0.4],
                "image" : "<partImage>:recap"
              }
            }
          }
        }
      }
    }
  },

  "transformationGroups" : {
    "drink" : {}
  },

  "sounds" : {
    "drink" : [ "/sfx/at_ext_drink/at_ext_bottledrink.ogg" ]
  }
}
